# Klijent (Vite ih ugrađuje u bandl — samo javni ključevi!)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Samo na serveru (Vercel funkcije u api/) — nikada VITE_ prefiks
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # Secret na Vercel-u; keš i ograničenje zahteva
GOOGLE_BOOKS_API_KEY=           # obavezan za Google Books (bez njega Google odgovara 429)
INFOBIP_API_KEY=
INFOBIP_BASE_URL=

# Samo lokalno (vercel dev, .env.local), kad servisni ključ nije dostupan: preskače
# keš i ograničenje zahteva. Provera prijave ostaje. Ignoriše se na Vercel-u.
# ZAHTEVI_BEZ_BAZE=1
